# BlinkBuild Environment Variables (Names Only — Do Not Commit Secrets)
# Copy to client/.env.local for local Next.js dev, or .env at repo root for Docker Compose.

# Client: Google Gemini API key (legacy single-call path)
API_KEY=

# Client: Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Shared internal client <-> server secret and URL
BLINKBUILD_SERVER_URL=
BLINKBUILD_SERVER_SECRET=

# Server: SQLite database path (on Docker named volume in production)
SQLITE_DB_PATH=

# Server: Per-agent LLM model strings (supplied by human at H4; no hardcoded defaults)
LLM_MODEL_MANAGER=
LLM_MODEL_FRONTEND=
LLM_MODEL_BACKEND=
LLM_MODEL_QA=

# Server: LLM provider credentials / endpoints
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_BEARER_TOKEN=
LLM_FALLBACK_CHAIN=

# Server: Optional throttling (requests per minute; unset = throttling off)
LLM_RPM_GROQ=
LLM_RPM_OLLAMA=
LLM_RPM_GEMINI=

# Server: Optional per-run limits (unset = allowed with audit warning)
RUN_MAX_LLM_CALLS=
RUN_MAX_TOKENS=
RUN_MAX_SECONDS=

# Server: Sandbox settings (sibling Docker containers)
DOCKER_HOST=
SANDBOX_IMAGE=
SANDBOX_TIMEOUT_SECONDS=
SANDBOX_MEM_LIMIT=
SANDBOX_NANO_CPUS=
SANDBOX_INSTALL_NETWORK=
